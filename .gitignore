# Build outputs, except the checked-in toolchain module (build/cmake/ is source,
# referenced by CMakePresets.json and ADR-0010).
/build/*
!/build/cmake/
!/build/cmake/**
.env
.env.*
__pycache__/
*.pyc
*.pyo
.pytype/
.pytest_cache/
.mypy_cache/

*.pfx
*.p12
*.key
tests/conformance/private/

*:Zone.Identifier
